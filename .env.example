# Required for live research mode.
OPENAI_API_KEY=

# Optional runtime tuning.
RESEARCH_AGENT_MODEL=gpt-5.4-mini
RESEARCH_MAX_RETRIES=3
RESEARCH_MAX_TOOL_ROUNDS=4
RESEARCH_SOURCE_TIMEOUT=12
RESEARCH_AGENT_MAX_QUERY_COUNT=4
RESEARCH_AGENT_RETRIEVAL_BUDGET=20
RESEARCH_AGENT_FRESHNESS_MODE=any
# Optional comma-separated planner requirements, for example: academic,official
RESEARCH_AGENT_REQUIRED_SOURCE_KINDS=
